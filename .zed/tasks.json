[
  {
    "label": "FastEditor: Build",
    "command": "./scripts/build.sh",
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "hide": "never"
  },
  {
    "label": "FastEditor: Run",
    "command": "./scripts/run.sh",
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "hide": "never"
  },
  {
    "label": "FastEditor: Rust Tests",
    "command": "source \"$HOME/.cargo/env\" && cargo test",
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "hide": "never",
    "tags": ["rust-test"]
  },
  {
    "label": "FastEditor: Swift Build",
    "command": "DEVELOPER_DIR=\"${DEVELOPER_DIR:-$(xcode-select -p)}\"; SDKROOT=\"${SDKROOT:-$(DEVELOPER_DIR=\"$DEVELOPER_DIR\" xcrun --sdk macosx --show-sdk-path)}\"; DEVELOPER_DIR=\"$DEVELOPER_DIR\" SDKROOT=\"$SDKROOT\" xcrun swift build",
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "hide": "never"
  },
  {
    "label": "FastEditor: Open current file in Xcode",
    "command": "./scripts/open-current-file-in-xcode.sh",
    "args": ["$ZED_FILE"],
    "allow_concurrent_runs": false,
    "reveal": "never",
    "hide": "always"
  }
]
